# ==============================================================================
# File: .gitignore
# Purpose: Prevent build artifacts, virtual environments, node_modules, and
#          large model weights (>100MB) from polluting Git history.
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# PyTorch Weights & Models (Large binary files > 100MB)
*.pth
*.pt
*.bin
*.onnx
weights/
!weights/.gitkeep

# Environment variables & local secrets
.env
.env.local
*.env

# Node / Frontend
node_modules/
dist/
.next/
out/
.vercel
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
